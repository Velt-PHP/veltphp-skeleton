#!/usr/bin/env php
<?php

declare(strict_types=1);

use Velt\Database\Migrations\Migrator;
use Velt\Database\Seeders\SeederRunner;
use App\Preview\Services\PreviewService;
use App\Setup\ProjectConfigurator;

$basePath = dirname(__DIR__);
$autoload = $basePath . '/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "Velt error: dependencies are not installed. Run composer install.\n");
    exit(1);
}

require $autoload;

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? 'help';
$options = commandOptions($argv);

if ($command === 'serve') {
    $host = $argv[2] ?? '0.0.0.0:8000';
    $docroot = $basePath . '/public';
    echo "Starting Velt on http://{$host}\n";
    if (str_starts_with($host, '0.0.0.0:')) {
        echo "Local URL: http://127.0.0.1:" . portFromHost($host) . "\n";
        echo "Mobile URL: http://" . detectLocalNetworkIp() . ':' . portFromHost($host) . "\n";
    } elseif (str_starts_with($host, '127.0.0.1:') || str_starts_with($host, 'localhost:')) {
        echo "Warning: this address is not reachable from a phone.\n";
        echo "Use velt serve 0.0.0.0:" . portFromHost($host) . " for mobile preview.\n";
    }
    passthru(sprintf('php -S %s -t %s', escapeshellarg($host), escapeshellarg($docroot)));
    exit(0);
}

if ($command === 'project:configure') {
    try {
        configureProject($basePath, $options);
        exit(0);
    } catch (Throwable $exception) {
        fwrite(STDERR, "Velt error: {$exception->getMessage()}\n");
        exit(1);
    }
}

$kernel = require $basePath . '/bootstrap/app.php';

try {
    match ($command) {
        'migrate' => migrate($basePath),
        'migrate:rollback' => rollback($basePath),
        'db:seed' => seed($basePath),
        'preview' => preview($basePath, ...previewArguments($argv)),
        'kernel:check' => kernelCheck($kernel),
        'help' => help(),
        default => unknown($command),
    };
} catch (Throwable $exception) {
    fwrite(STDERR, "Velt error: {$exception->getMessage()}\n");
    exit(1);
}

/**
 * @param array<int, string> $argv
 * @return array<string, string|bool>
 */
function commandOptions(array $argv): array
{
    $options = [];

    foreach (array_slice($argv, 2) as $token) {
        if (!str_starts_with($token, '--')) {
            continue;
        }

        [$name, $value] = array_pad(explode('=', substr($token, 2), 2), 2, true);
        $options[$name] = $value;
    }

    return $options;
}

/** @param array<string, string|bool> $options */
function configureProject(string $basePath, array $options): void
{
    $result = (new ProjectConfigurator($basePath))->configure(
        (string) ($options['type'] ?? 'web'),
        (string) ($options['styling'] ?? 'tailwind'),
        (string) ($options['database'] ?? 'sqlite'),
    );

    echo "Velt project configured.\n";
    echo "Type: {$result['type']}\n";
    echo "Styling: {$result['styling']}\n";
    echo "Database: {$result['database']}\n";
}

/**
 * @param array<int, string> $argv
 * @return array{0: string|null, 1: string}
 */
function previewArguments(array $argv): array
{
    $first = $argv[2] ?? null;
    $second = $argv[3] ?? null;

    if ($first === null) {
        return [null, 'homepage'];
    }

    if (str_contains($first, ':') || str_contains($first, '://')) {
        return [$first, $second ?? 'homepage'];
    }

    return [null, $first];
}

function detectLocalNetworkIp(): string
{
    $socket = @stream_socket_client('udp://8.8.8.8:80', $errno, $error, 1);

    if (is_resource($socket)) {
        $name = stream_socket_get_name($socket, false);
        fclose($socket);

        if (is_string($name) && preg_match('/^([0-9.]+):[0-9]+$/', $name, $matches) === 1) {
            return $matches[1];
        }
    }

    $hostname = gethostname();

    if (is_string($hostname) && $hostname !== '') {
        $ip = gethostbyname($hostname);

        if ($ip !== $hostname && filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
            return $ip;
        }
    }

    return '127.0.0.1';
}

function portFromHost(string $host): string
{
    $parts = explode(':', $host);

    return end($parts) ?: '8000';
}

function preview(string $basePath, ?string $host, string $view): void
{
    $service = new PreviewService($basePath);
    $session = $service->createSession($host, $view);

    echo "Velt mobile preview\n";
    echo "ID: {$session['id']}\n";
    echo "View: {$session['view']}\n";
    echo "URL: {$session['url']}\n";
    echo "QR image: {$session['qr_image']}\n";
    echo $service->qrTerminal((string) $session['qr_payload']);
    echo "Scan this code with the Velt Preview app.\n";
}

function migrate(string $basePath): void
{
    $executed = (new Migrator($basePath . '/database/migrations'))->migrate();

    if ($executed === []) {
        echo "Nothing to migrate.\n";
        return;
    }

    foreach ($executed as $migration) {
        echo "Migrated: {$migration}\n";
    }
}

function rollback(string $basePath): void
{
    $rolledBack = (new Migrator($basePath . '/database/migrations'))->rollback();

    if ($rolledBack === []) {
        echo "Nothing to roll back.\n";
        return;
    }

    foreach ($rolledBack as $migration) {
        echo "Rolled back: {$migration}\n";
    }
}

function seed(string $basePath): void
{
    (new SeederRunner())->run(Database\Seeders\DatabaseSeeder::class);

    echo "Database seeded.\n";
}

/**
 * @param array<string, mixed> $kernel
 */
function kernelCheck(array $kernel): void
{
    foreach (['app', 'router', 'dispatcher'] as $key) {
        if (! array_key_exists($key, $kernel)) {
            throw new RuntimeException("Kernel entry [{$key}] is missing.");
        }
    }

    echo "Velt kernel is ready.\n";
}

function help(): void
{
    echo "Velt project CLI\n";
    echo "Usage:\n";
    echo "  velt serve [host:port]\n";
    echo "  velt preview [host:port] [view]\n";
    echo "  velt migrate\n";
    echo "  velt migrate:rollback\n";
    echo "  velt db:seed\n";
    echo "  velt kernel:check\n";
    echo "  velt project:configure --type=web|api|cross-platform --styling=tailwind|nativewind|none --database=sqlite\n";
}

function unknown(string $command): void
{
    throw new InvalidArgumentException("Unknown command [{$command}]. Run velt help.");
}
